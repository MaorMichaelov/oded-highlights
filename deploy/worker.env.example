# Copy to deploy/worker.env (git-ignored: *.env) and fill in. NEVER commit real values. This file contains placeholders only.

# --- studio connection (required) ---
STUDIO_URL=https://your-studio.example.workers.dev
STUDIO_WORKER_KEY=put-the-worker-key-here

# --- capacity ---
WORKER_CONCURRENCY=1            # parallel jobs, about 4 vCPU each
WORKER_POLL_S=10
WORKER_JOB_TIMEOUT_S=14400      # 4 h hard limit per attempt
WORKER_STALL_S=1800             # kill a job that prints nothing for 30 min
WORKER_RETRIES=1
WORKER_GRACE_S=600              # on stop: wait this long for running jobs
WORKER_MIN_FREE_GB=5
WORKER_KEEP_FAILED_H=24
WORKER_KEEP_DRAFTS_D=14

# --- where things live (the Docker image sets these to /data/...; on a plain PC point them anywhere) ---
# WORKER_WORK_DIR=/data/work
# WORKER_OUT_DIR=/data/out
# UPLOAD_DIR=/data/uploads
# INGEST_DIR=/data/ingest

# --- optional AI helpers (free tiers). Without any key the worker still works: local whisper + audio-peak picker ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# WORKER_NO_CLOUD=1              # 1 = never send customer audio/transcripts to Groq/Gemini (local models only)

# --- policy ---
# WORKER_BLOCK_HOSTS=kick.com    # hosts a customer link may not point to (Kick ToS)
# WORKER_TRUSTED_ORGS=           # org ids (comma separated) that may bypass the host block, e.g. the owner's own org
# WORKER_MAX_SOURCE_H=8
# WORKER_WATERMARK=0             # 1 = keep the signature style's logo watermark (owner channels only)
# CUSTOMER_PROFILES_DIR=/data/profiles   # <dir>/<org id>/profile.json (the studio agent's customer profile); job.hints.profile wins
# WORKER_LOG=json
# --- preview phase on GitHub Actions (set by .github/workflows/studio-worker.yml, see docs/STUDIO_PREVIEW_SETUP.md); leave unset on a private server
# WORKER_PLATFORM_VOD=1          # trusted orgs: "my last stream" = newest Kick/Twitch VOD of the verified channel
# WORKER_DOWNLOAD_MAX_MIN=30     # download only the first N minutes of a source (0 = whole)
# WORKER_DOWNLOAD_HEIGHT=720
# STUDIO_PREVIEW_PUBLISH=github-release   # + GITHUB_TOKEN, GITHUB_REPOSITORY, WORKER_PREVIEW_ORGS: 720p previews as release assets
# WORKER_MIN_CLAIM_MIN=5         # with --max-minutes: do not start a job with less time than this left
